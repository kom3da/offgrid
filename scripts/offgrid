#!/usr/bin/env python3
"""offgrid の学習用コマンド。AIもネットワークも使わない。

使い方: ./scripts/offgrid [サブコマンド] [引数]
引数なしで実行すると、ダッシュボードとメニューを出す。

Python 3 の標準ライブラリだけで動く（Ubuntu には最初から入っている）。
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
import time
import unicodedata
from dataclasses import dataclass, field
from datetime import date, datetime, timedelta
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TRACK_DIR = {"F": "foundation", "G": "go", "T": "ts", "D": "sql", "O": "infra", "C": "capstone"}


class Abort(Exception):
    """中断（q や Ctrl+C）。"""


# ---------------------------------------------------------------- 表示


class Style:
    """色と装飾。端末でないときや NO_COLOR のときは、何も付けない。"""

    def __init__(self) -> None:
        self.on = sys.stdout.isatty() and not os.environ.get("NO_COLOR")

    def _w(self, code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if self.on else text

    def bold(self, t: str) -> str:
        return self._w("1", t)

    def dim(self, t: str) -> str:
        return self._w("2", t)

    def cyan(self, t: str) -> str:
        return self._w("36", t)

    def green(self, t: str) -> str:
        return self._w("32", t)

    def yellow(self, t: str) -> str:
        return self._w("33", t)

    def red(self, t: str) -> str:
        return self._w("31", t)


S = Style()


def width(text: str) -> int:
    """全角を2、半角を1として数える。"""
    plain = re.sub(r"\033\[[0-9;]*m", "", text)
    return sum(2 if unicodedata.east_asian_width(ch) in "WF" else 1 for ch in plain)


def cols(limit: int = 92) -> int:
    return max(48, min(shutil.get_terminal_size((88, 24)).columns, limit))


def wrap(text: str, indent: str = "  ") -> list[str]:
    """全角を考えて折り返す。日本語なので単語の途中でも切る。"""
    out: list[str] = []
    room = cols() - width(indent)
    for para in text.split("\n"):
        if not para.strip():
            out.append("")
            continue
        head = indent
        extra = ""
        bullet = re.match(r"^(\s*(?:[-*]|\d+\.)\s+)", para)
        if bullet:
            extra = " " * width(bullet.group(1))
        line = ""
        for ch in para:
            if width(line) + width(ch) > room - (width(extra) if out and line == "" else 0):
                out.append(head + line)
                head = indent + extra
                line = "" if ch.isspace() else ch
            else:
                line += ch
        out.append(head + line)
    return out


def say(text: str, indent: str = "  ") -> None:
    for line in wrap(text, indent):
        print(line)


def rule(title: str = "", char: str = "─") -> None:
    if not title:
        print(S.dim(char * cols()))
        return
    head = f"{char}{char} {title} "
    print(S.cyan(head + char * max(0, cols() - width(head))))


def banner(lines: list[str]) -> None:
    w = cols()
    print(S.cyan("┌" + "─" * (w - 2) + "┐"))
    for line in lines:
        print(S.cyan("│ ") + line + " " * max(0, w - 4 - width(line)) + S.cyan(" │"))
    print(S.cyan("└" + "─" * (w - 2) + "┘"))


def pad(text: str, room: int) -> str:
    """表示幅を room にそろえる（長すぎるときは詰める）。"""
    if width(text) > room:
        out = ""
        for ch in text:
            if width(out) + width(ch) > room - 1:
                return out + "…"
            out += ch
        return out
    return text + " " * (room - width(text))


def bar(done: int, total: int, size: int = 16) -> str:
    if total <= 0:
        return S.dim("░" * size)
    filled = round(size * done / total)
    color = S.green if done == total else (S.yellow if done else S.dim)
    return color("▇" * filled) + S.dim("░" * (size - filled))


def ask(prompt: str, allow: str = "") -> str:
    """1行を読む。Ctrl+D と Ctrl+C は中断あつかい。allow は「/」区切り。"""
    options = allow.split("/") if allow else []
    while True:
        try:
            got = input(S.bold(prompt)).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            raise Abort from None
        if not options:
            return got
        if got.lower() in options:
            return got.lower()
        shown = "、".join(o if o else "Enter" for o in options)
        print(S.dim(f"  {shown} のどれかを入れてください"))


def confirm(prompt: str) -> bool:
    return ask(prompt, allow="y/n/") == "y"


def die(message: str) -> None:
    print(S.red(f"error: {message}"), file=sys.stderr)
    raise SystemExit(1)


def read_text(path: Path) -> str:
    """読めない文字があっても落ちないように読む。"""
    return path.read_text(encoding="utf-8", errors="replace")


def md_files(*patterns: str) -> list[Path]:
    """Markdown を集める。隠しファイル（`._` など）は飛ばす。"""
    out: list[Path] = []
    for pat in patterns:
        out += [f for f in sorted(ROOT.glob(pat)) if f.is_file() and not f.name.startswith(".")]
    return out


def rel(path: Path) -> str:
    try:
        return str(path.relative_to(ROOT))
    except ValueError:
        return str(path)


# ---------------------------------------------------------------- 課題シート


@dataclass
class Sheet:
    path: Path
    unit: str
    title: str = ""
    header: str = ""
    sections: dict[str, str] = field(default_factory=dict)
    tasks: dict[int, str] = field(default_factory=dict)

    @property
    def dir(self) -> Path:
        return self.path.parent

    @property
    def work(self) -> Path:
        return self.dir / "work.md"

    def section(self, name: str) -> str:
        return self.sections.get(name, "").strip()

    def keep_files(self) -> list[str]:
        found = re.findall(r"`([A-Za-z0-9._-]+\.(?:md|sh|sql|go|ts|tsx|js|txt|csv))`", self.section("残すもの"))
        skip = {"TASKS.md", "TASKS.local.md", "work.md"}
        return sorted({f for f in found if f not in skip})

    def missing_files(self) -> list[str]:
        out = []
        for f in self.keep_files():
            p = self.dir / f
            if not p.exists() or p.stat().st_size == 0:
                out.append(f)
        return out


def parse_sheet(path: Path, unit: str) -> Sheet:
    text = read_text(path)
    sheet = Sheet(path=path, unit=unit)
    fm = re.match(r'^---\ntitle: "(.*?)"\n---\n', text)
    if fm:
        sheet.title = fm.group(1)
        text = text[fm.end():]
    body = text.lstrip("\n")
    if body.startswith(">"):
        sheet.header = body.split("\n", 1)[0].lstrip("> ").strip()
    name, buf, in_tasks = "", [], False
    for line in body.split("\n"):
        head = re.match(r"^(#{2,3}) (.+)$", line)
        if head:
            if name:
                sheet.sections[name] = "\n".join(buf).strip()
            name, buf = head.group(2).strip(), []
            in_tasks = name == "課題"
            continue
        buf.append(line)
        if in_tasks:
            num = re.match(r"^(\d+)\. (.*)$", line)
            if num:
                sheet.tasks[int(num.group(1))] = num.group(2)
            elif sheet.tasks and line.startswith("   "):
                sheet.tasks[max(sheet.tasks)] += "\n" + line.rstrip()
    if name:
        sheet.sections[name] = "\n".join(buf).strip()
    return sheet


def load_sheet(unit: str) -> Sheet | None:
    m = re.match(r"^([FGTDOC])0*(\d+)$", (unit or "").strip().upper())
    if not m:
        return None
    letter, num = m.group(1), int(m.group(2))
    base = ROOT / "drills" / TRACK_DIR[letter]
    if not base.is_dir():
        return None
    for d in sorted(base.iterdir()):
        if d.is_dir() and d.name.upper().startswith(f"{letter}{num:02d}-"):
            for name in ("TASKS.md", "TASKS.local.md"):
                if (d / name).exists():
                    return parse_sheet(d / name, f"{letter}{num}")
    return None


# ---------------------------------------------------------------- 進捗と振り返り


@dataclass
class Progress:
    path: Path
    stage: str = "0"
    unit: str = ""
    db_unit: str = ""
    tracks: dict[str, list[tuple[str, bool]]] = field(default_factory=dict)

    def all_units(self) -> list[tuple[str, bool]]:
        return [u for units in self.tracks.values() for u in units]

    def is_done(self, unit: str) -> bool:
        return any(u.upper() == unit.upper() and ok for u, ok in self.all_units())

    def mark_done(self, unit: str) -> bool:
        lines = read_text(self.path).split("\n")
        pat = re.compile(rf"^- \[ \] {re.escape(unit.upper())} ")
        for i, line in enumerate(lines):
            if pat.match(line):
                lines[i] = line.replace("- [ ]", "- [x]", 1) + f" — {date.today():%Y-%m-%d}"
                self.path.write_text("\n".join(lines), encoding="utf-8")
                return True
        return False

    def set_next(self, unit: str, db: bool = False) -> None:
        label = "次のPostgreSQLユニット" if db else "次のユニット"
        text = read_text(self.path)
        new, n = re.subn(rf"^- {label}：.*$", f"- {label}：{unit}", text, count=1, flags=re.M)
        if n == 0 and db:
            new = re.sub(r"^(- 次のユニット：.*)$", rf"\1\n- {label}：{unit}", text, count=1, flags=re.M)
            n = 1
        if n:
            self.path.write_text(new, encoding="utf-8")


def load_progress() -> Progress:
    path = ROOT / "PROGRESS.md"
    if not path.exists():
        die("PROGRESS.md がありません。学習用リポジトリの中で実行してください")
    p = Progress(path=path)
    track = ""
    for line in read_text(path).split("\n"):
        if m := re.match(r"^- ステージ：\s*(.+)$", line):
            digits = re.sub(r"\D", "", m.group(1))
            p.stage = digits[0] if digits else "0"
        elif m := re.match(r"^- 次のユニット：\s*(\S+)", line):
            p.unit = m.group(1)
        elif m := re.match(r"^- 次のPostgreSQLユニット：\s*(\S+)", line):
            p.db_unit = m.group(1)
        elif m := re.match(r"^### (.+)$", line):
            track = m.group(1).strip()
            p.tracks.setdefault(track, [])
        elif m := re.match(r"^- \[([ x])\] ([FGTDOC]\d+)\b", line):
            p.tracks.setdefault(track, []).append((m.group(2), m.group(1) == "x"))
    if not p.unit:
        die("PROGRESS.md の「現在」に「- 次のユニット：F1」の行を書いてください")
    return p


@dataclass
class Session:
    number: int
    log: Path
    past: list[Path]

    @property
    def afternoon(self) -> str:
        return "コードリーディング" if self.number % 2 == 1 else "デバッグドリル"

    @property
    def warmup(self) -> str:
        if not self.past:
            return "初回なので、再現するものがない。代わりに「Ubuntuのシェルを開き、`cd ~/offgrid-log` で移動し、`ls` で中身を見る」を、何も見ずにやる"
        which = "前回のセッションでやったこと" if self.number % 2 == 1 else "4セッション以上前にやったこと"
        return f"{which}を、何も見ずに再現する"

    @property
    def review_log(self) -> Path | None:
        if not self.past:
            return None
        return self.past[-1] if self.number % 2 == 1 else self.past[max(0, len(self.past) - 4)]

    @property
    def finish(self) -> str:
        if self.number <= 3:
            return "12:00まで（3時間。最後の30分で振り返り）"
        if self.number <= 6:
            return "14:00まで（4時間。最後の30分で振り返り）"
        return "16:00まで（6時間）"


def load_session() -> Session:
    today = date.today()
    log = ROOT / "logs" / f"{today:%Y}" / f"{today:%m-%d}.md"
    past = [f for f in md_files("logs/*/*.md") if f != log]
    log.parent.mkdir(parents=True, exist_ok=True)
    if not log.exists():
        template = ROOT / "templates" / "retrospective.md"
        if not template.exists():
            die("templates/retrospective.md がありません")
        log.write_text(read_text(template), encoding="utf-8")
    return Session(number=len(past) + 1, log=log, past=past)


def stage_plan(stage: str) -> dict[str, str]:
    table = {
        "0": {"main": "3.5時間", "db": "", "search": "5回"},
        "1": {"main": "2.5時間", "db": "1時間", "search": "5回"},
        "2": {"main": "2.5時間", "db": "1時間", "search": "5回"},
        "3": {"main": "3.5時間（DBを含む）", "db": "", "search": "3回"},
    }
    return table.get(stage, {"main": "3.5時間", "db": "", "search": "0回（オフラインのドキュメントだけ）"})


# ---------------------------------------------------------------- 作業記録（work.md）


def ensure_work(sheet: Sheet, quiet: bool = False) -> None:
    if sheet.work.exists():
        return
    lines = [f"# {sheet.title} 作業記録", ""]
    lines += wrap("課題の進み具合。`./scripts/offgrid run` が、ここを見て次の課題を出す。自分で書き換えてもよい。メモは `notes.md` に書く。", "")
    lines += [""]
    for n in sorted(sheet.tasks):
        lines.append(f"- [ ] {n}. {sheet.tasks[n].splitlines()[0]}")
    sheet.work.write_text("\n".join(lines) + "\n", encoding="utf-8")
    if not quiet:
        print(S.dim(f"  作業記録を作りました: {rel(sheet.work)}"))


def work_state(sheet: Sheet) -> dict[int, bool]:
    if not sheet.work.exists():
        return {}
    out: dict[int, bool] = {}
    for line in read_text(sheet.work).split("\n"):
        if m := re.match(r"^- \[([ x])\] (\d+)\.", line):
            out[int(m.group(2))] = m.group(1) == "x"
    return out


def work_tick(sheet: Sheet, n: int, done: bool = True) -> None:
    ensure_work(sheet, quiet=True)
    lines = read_text(sheet.work).split("\n")
    for i, line in enumerate(lines):
        m = re.match(r"^- \[([ x])\] (\d+)\.", line)
        if m and int(m.group(2)) == n:
            lines[i] = re.sub(r"^- \[[ x]\]", "- [x]" if done else "- [ ]", line, count=1)
    sheet.work.write_text("\n".join(lines), encoding="utf-8")


def work_counts(sheet: Sheet) -> tuple[int, int]:
    st = work_state(sheet)
    if not st:
        return 0, len(sheet.tasks)
    return sum(1 for v in st.values() if v), len(st)


# ---------------------------------------------------------------- 振り返り


def retro_fields(log: Path) -> list[tuple[int, str]]:
    """（行番号, 見出し）の一覧。テンプレートのまま空いている欄。"""
    out: list[tuple[int, str]] = []
    heading = ""
    for i, line in enumerate(read_text(log).split("\n")):
        if line.startswith("#"):
            heading = line.lstrip("# ").strip()
            continue
        if re.match(r"^- *$", line) or re.match(r"^\d+\. *$", line):
            out.append((i, heading or "（見出しなし）"))
        elif re.search(r"：\s*$", line):
            out.append((i, line.strip().lstrip("- ")))
    return out


def retro_write(log: Path, index: int, text: str) -> None:
    lines = read_text(log).split("\n")
    line = lines[index]
    if re.match(r"^- *$", line):
        lines[index] = f"- {text}"
    elif m := re.match(r"^(\d+)\. *$", line):
        lines[index] = f"{m.group(1)}. {text}"
    else:
        lines[index] = line.rstrip() + text
    log.write_text("\n".join(lines), encoding="utf-8")


def append_stuck(log: Path, text: str) -> None:
    lines = read_text(log).split("\n")
    entry = f"- {datetime.now():%H:%M} {text}"
    for i, line in enumerate(lines):
        if line.startswith("## 詰まったこと"):
            j = i + 1
            while j < len(lines) and not lines[j].startswith("#"):
                j += 1
            k = j - 1
            while k > i and not lines[k].strip():
                k -= 1
            if re.match(r"^- *$", lines[k]):
                lines[k] = entry
            else:
                lines.insert(k + 1, entry)
            log.write_text("\n".join(lines), encoding="utf-8")
            return
    log.write_text("\n".join([*lines, entry]), encoding="utf-8")


# ---------------------------------------------------------------- git


def git(*args: str) -> tuple[int, str]:
    try:
        r = subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True, check=False)
    except FileNotFoundError:
        return 127, "git が入っていません"
    return r.returncode, (r.stdout + r.stderr).strip()


# ---------------------------------------------------------------- 作業漏れ


def find_gaps(p: Progress, s: Session) -> list[str]:
    out: list[str] = []
    for unit, checked in p.all_units():
        sheet = load_sheet(unit)
        if sheet is None:
            continue
        done, total = work_counts(sheet)
        others = [f for f in sheet.dir.iterdir() if f.is_file() and not f.name.startswith("TASKS")]
        if checked and sheet.missing_files():
            out.append(f"{unit}: 完了だが、残すものが無い → {'、'.join(sheet.missing_files())}")
        elif not checked and total and done == total:
            out.append(f"{unit}: 課題は全部できている → 完了条件を確かめて『done {unit}』")
        elif not checked and 0 < done < total:
            out.append(f"{unit}: 途中（課題 {done}/{total}）")
        elif not checked and others and not sheet.work.exists():
            out.append(f"{unit}: 書いたものがあるのに、記録が無い → 『check {unit}』")
    holes = [(lg, len(retro_fields(lg))) for lg in s.past]
    holes = [(lg, n) for lg, n in holes if n]
    for lg, n in sorted(holes, key=lambda x: x[0], reverse=True)[:3]:
        out.append(f"{rel(lg)}: 振り返りの空欄が{n}個 → 『retro {rel(lg)}』")
    if len(holes) > 3:
        out.append(f"ほか、空欄のある振り返りが{len(holes) - 3}件")
    code, dirty = git("status", "--porcelain")
    if code == 0 and dirty:
        out.append(f"コミットしていない変更が{len(dirty.splitlines())}件 → 『end』")
    code, ahead = git("log", "--oneline", "@{u}..")
    if code == 0 and ahead:
        out.append(f"push していないコミットが{len(ahead.splitlines())}件 → git push origin main")
    return out


# ---------------------------------------------------------------- 画面


def show_dashboard(p: Progress, s: Session) -> None:
    sheet = load_sheet(p.unit)
    banner([
        S.bold(f"offgrid   第{s.number}回   Stage {p.stage}"),
        f"次のユニット: {S.bold(p.unit)}  {sheet.title if sheet else ''}",
        f"今日の終わり: {s.finish}",
    ])
    print()
    rule("進み具合")
    td = ta = 0
    for track, units in p.tracks.items():
        if not units:
            continue
        done = sum(1 for _, ok in units if ok)
        td, ta = td + done, ta + len(units)
        print(f"  {pad(track, 30)} {bar(done, len(units))} {done:>2}/{len(units)}")
    if ta:
        print(f"  {pad('合計', 30)} {bar(td, ta)} {td:>2}/{ta}")
    if sheet:
        done, total = work_counts(sheet)
        print(f"  {pad(f'{p.unit} の課題', 30)} {bar(done, total)} {done:>2}/{total}")
    gaps = find_gaps(p, s)
    if gaps:
        print()
        rule("気になるところ")
        for g in gaps:
            say(S.yellow("! ") + g)


MENU = [
    ("1", "セッションを始める（案内つき）", "run"),
    ("2", "次の課題だけ見る", "next"),
    ("3", "課題シートを読む", "unit"),
    ("4", "調べる（オフライン検索）", "find"),
    ("5", "確認コマンドを実行する", "check"),
    ("6", "詰まりメモを書く", "stuck"),
    ("7", "振り返りを書く", "retro"),
    ("8", "終わりの手続き", "end"),
    ("q", "やめる", ""),
]


def show_menu(p: Progress, s: Session) -> None:
    while True:
        print()
        rule("何をする？")
        for key, label, _ in MENU:
            print(f"  {S.bold(key)}. {label}")
        got = ask("\n  番号を入れて Enter: ", allow="/".join(k for k, _, _ in MENU))
        if got in ("q", ""):
            return
        cmd = next(c for k, _, c in MENU if k == got)
        print()
        try:
            if cmd == "run":
                cmd_run(p, s)
                return
            if cmd == "next":
                cmd_next(p, [])
            elif cmd == "unit":
                cmd_unit(p, [ask(f"  ユニットID（Enterで {p.unit}）: ") or p.unit])
            elif cmd == "find":
                word = ask("  探す言葉: ")
                if word:
                    cmd_find(p, [word])
            elif cmd == "check":
                cmd_check(p, [])
            elif cmd == "stuck":
                cmd_stuck(p, s, [])
            elif cmd == "retro":
                cmd_retro(p, [], session=s)
            elif cmd == "end":
                cmd_end(p, s)
        except Abort:
            print(S.dim("  中断しました"))


def show_task(sheet: Sheet, n: int) -> None:
    done, total = work_counts(sheet)
    rule(f"{sheet.unit} 課題 {n}／{total}（できた {done}）")
    print()
    say(sheet.tasks[n])
    print()


def show_panels(sheet: Sheet, names: tuple[str, ...]) -> None:
    for name in names:
        body = sheet.section(name)
        if not body:
            continue
        rule(name)
        for line in body.split("\n"):
            print(("  " + line) if line.strip() else "")
        print()


# ---------------------------------------------------------------- サブコマンド


def guide_unit(sheet: Sheet, s: Session) -> None:
    ensure_work(sheet)
    skip: set[int] = set()
    while True:
        st = work_state(sheet)
        todo = [n for n in sorted(st) if not st[n] and n not in skip]
        done, total = work_counts(sheet)
        if not todo:
            if total and done == total:
                print(S.green(f"  ✓ {sheet.unit} の課題は全部できました（{done}/{total}）"))
                say(f"完了条件を確かめる → 『check {sheet.unit}』")
            else:
                print(S.dim(f"  この枠はここまで（{done}/{total}）"))
            return
        n = todo[0]
        print()
        show_task(sheet, n)
        got = ask("  [Enter]できた  [s]詰まった  [l]あとで  [k]手がかり  [d]枠を終える  [q]中断: ",
                  allow="/y/s/l/k/d/q")
        if got in ("", "y"):
            work_tick(sheet, n)
            done, total = work_counts(sheet)
            print(S.green(f"  ✓ 課題{n}（{done}/{total}）"))
        elif got == "s":
            memo = ask("  何が起きた？（1行。Enterで飛ばす）: ")
            if memo:
                append_stuck(s.log, f"{sheet.unit} 課題{n}: {memo}")
                print(S.green("  → 詰まりメモに書きました"))
            say(S.dim("15分たったら、エラー文を全文読む→man→最小の再現→検索、の順に切り替える。45分で打ち切る"))
            skip.add(n)
        elif got == "l":
            skip.add(n)
        elif got == "k":
            print()
            show_panels(sheet, ("キーワード", "詰まりやすいところ", "平日に読むもの"))
        elif got == "d":
            return
        else:
            raise Abort


def cmd_run(p: Progress, s: Session) -> None:
    show_dashboard(p, s)
    print()
    say(S.dim("上から順に案内します。q で中断できます（続きから再開できます）"))
    plan = stage_plan(p.stage)

    print()
    step = 1
    rule(f"{step}. ウォームアップ（30分）")
    say(s.warmup)
    say("＋ 前回のレビューで指摘された箇所の直しを1件")
    if s.review_log:
        say(S.dim(f"見返すログ: {rel(s.review_log)}"))
    ask("\n  終わったら Enter（q=中断）: ", allow="/q")

    sheet = load_sheet(p.unit)
    if sheet is None:
        die(f"{p.unit} の課題シートが見つかりません。PROGRESS.md を確かめてください")
    step += 1
    print()
    rule(f"{step}. メイン（{plan['main']}）／ {p.unit} {sheet.title}")
    say(S.dim(f"シート: {rel(sheet.path)}　Web検索は{plan['search']}まで"))
    guide_unit(sheet, s)

    if plan["db"]:
        step += 1
        print()
        if p.db_unit and load_sheet(p.db_unit):
            rule(f"{step}. PostgreSQL（{plan['db']}）／ {p.db_unit}")
            guide_unit(load_sheet(p.db_unit), s)  # type: ignore[arg-type]
        else:
            rule(f"{step}. PostgreSQL（{plan['db']}）")
            say("PROGRESS.md の「現在」に「- 次のPostgreSQLユニット：D1」の行を足すと、ここでも案内します")
            ask("\n  終わったら Enter（q=中断）: ", allow="/q")

    step += 1
    print()
    rule(f"{step}. {s.afternoon}（1.5時間）")
    if s.afternoon == "コードリーディング":
        say("読解課題は docs/05-debug-and-reading.md の一覧から、今のステージのものを選ぶ。メモは drills/reading/ に置く")
    else:
        say("問題は drills/debug/ の中。答え（answers/）は、3つ直し終わるまで開かない。直したら、そのバグを見つけるテストを1本足す")
    ask("\n  終わったら Enter（q=中断）: ", allow="/q")

    step += 1
    print()
    rule(f"{step}. 振り返り（30分）")
    cmd_retro(p, [], session=s)

    step += 1
    print()
    rule(f"{step}. 終わりの手続き")
    cmd_end(p, s)


def cmd_today(p: Progress, s: Session) -> None:
    show_dashboard(p, s)
    plan = stage_plan(p.stage)
    sheet = load_sheet(p.unit)
    print()
    rule("今日の流れ")
    steps = [
        f"ウォームアップ（30分）：{s.warmup}",
        f"メイン（{plan['main']}）：{rel(sheet.path) if sheet else p.unit}",
    ]
    if plan["db"]:
        steps.append(f"PostgreSQL（{plan['db']}）：{p.db_unit or '（PROGRESS.md に「次のPostgreSQLユニット」を書く）'}")
    steps += [f"{s.afternoon}（1.5時間）", f"振り返り（30分）：{rel(s.log)}"]
    for i, text in enumerate(steps, 1):
        say(f"{i}. {text}")
    print()
    say(S.bold("案内つきで進める → ./scripts/offgrid run"))


def cmd_next(p: Progress, args: list[str]) -> None:
    unit = args[0] if args else p.unit
    sheet = load_sheet(unit)
    if sheet is None:
        die(f"{unit} の課題シートが見つかりません")
    ensure_work(sheet)
    st = work_state(sheet)
    todo = [n for n in sorted(st) if not st[n]]
    if not todo:
        done, total = work_counts(sheet)
        print(S.green(f"{sheet.unit} の課題は全部できています（{done}/{total}）"))
        say(f"完了条件を確かめる → ./scripts/offgrid check {sheet.unit}")
        return
    show_task(sheet, todo[0])
    say(S.dim(f"できたら → ./scripts/offgrid tick {todo[0]}"))


def cmd_tick(p: Progress, args: list[str]) -> None:
    if not args or not args[0].isdigit():
        die("使い方: ./scripts/offgrid tick <課題の番号> [ユニットID]")
    unit = args[1] if len(args) > 1 else p.unit
    sheet = load_sheet(unit)
    if sheet is None:
        die(f"{unit} の課題シートが見つかりません")
    work_tick(sheet, int(args[0]))
    done, total = work_counts(sheet)
    print(S.green(f"{sheet.unit} 課題{args[0]}: できた（{done}/{total}）"))


def cmd_status(p: Progress, s: Session) -> None:
    show_dashboard(p, s)
    print()
    rule("セッション")
    say(f"済んだ回数: {len(s.past)}回" + (f"（最後: {rel(s.past[-1])}）" if s.past else ""))
    if s.past:
        say(f"4回ごとの見直しまで: あと {4 - len(s.past) % 4}回")
    say(f"次の関門: Stage {p.stage} の確認項目と実技（docs/06-evaluation.md）")


def cmd_unit(p: Progress, args: list[str]) -> None:
    unit = args[0] if args else p.unit
    sheet = load_sheet(unit)
    if sheet is None:
        die(f"{unit} の課題シートが見つかりません")
    pager = shutil.which("less")
    if sys.stdout.isatty() and pager:
        subprocess.run([pager, "-R", str(sheet.path)], check=False)
    else:
        print(read_text(sheet.path))


def cmd_find(p: Progress, args: list[str]) -> None:
    if not args:
        die("使い方: ./scripts/offgrid find <語>")
    word = args[0]
    groups = [
        ("カリキュラム", md_files("docs/*.md")),
        ("課題シート", md_files("drills/*/*/TASKS*.md")),
        ("AIへの頼み方", md_files("prompts/*.md")),
        ("自分のメモと振り返り",
         [f for f in md_files("drills/*/*/*.md") if not f.name.startswith("TASKS")]
         + md_files("logs/*/*.md")),
    ]
    total = 0
    for label, files in groups:
        hits = []
        for f in files:
            try:
                for i, line in enumerate(read_text(f).split("\n"), 1):
                    if word in line:
                        hits.append(f"  {S.cyan(rel(f))}:{i}  {line.strip()[:110]}")
            except OSError:
                continue
        if hits:
            rule(f"{label}（{len(hits)}件）")
            print("\n".join(hits[:12]))
            if len(hits) > 12:
                print(S.dim(f"  ほか{len(hits) - 12}件"))
            print()
            total += len(hits)
    if not total:
        print(S.dim(f"「{word}」は見つかりませんでした"))


def cmd_check(p: Progress, args: list[str]) -> None:
    unit = args[0] if args else p.unit
    sheet = load_sheet(unit)
    if sheet is None:
        die(f"{unit} の課題シートが見つかりません")
    letter = sheet.unit[0]
    workdir = sheet.dir
    rule(f"{sheet.unit} の確認（{rel(workdir)}）")
    cmds: list[list[str]] = []
    note = ""
    if letter in ("F", "O"):
        found = sorted(workdir.glob("*.sh"))
        if not found:
            note = "シェルスクリプトがまだない"
        elif shutil.which("shellcheck"):
            cmds.append(["shellcheck", *[f.name for f in found]])
        else:
            note = "shellcheck が入っていない（sudo apt install shellcheck）"
    elif letter in ("G", "C"):
        target = ROOT / "capstone" if letter == "C" else workdir
        if (target / "go.mod").exists():
            workdir = target
            cmds += [["go", "vet", "./..."], ["go", "test", "-race", "-cover", "./..."]]
        else:
            note = f"{rel(target)}/go.mod がまだない（go mod init から）"
    elif letter == "T":
        if (workdir / "package.json").exists():
            cmds += [["npx", "tsc", "--noEmit", "--strict"], ["npx", "vitest", "run"]]
        else:
            note = f"{rel(workdir)}/package.json がまだない（npm init から）"
    elif letter == "D":
        found = sorted(workdir.glob("*.sql"))
        if not found:
            note = ".sql ファイルがまだない"
        else:
            note = "次のコマンドで実行できる（データベース名は課題シートを見る）\n" + "\n".join(
                f"docker exec -i pg-offgrid psql -U postgres -v ON_ERROR_STOP=1 < {rel(f)}" for f in found)
    if note:
        say(note)
    for c in cmds:
        print(S.dim(f"  ＋ {' '.join(c)}"))
        r = subprocess.run(c, cwd=workdir, check=False)
        print(S.green("  → 通りました") if r.returncode == 0 else S.red("  → 失敗（出力を読んで直す）"))
    print()
    rule("残すもの")
    keep = sheet.keep_files()
    if not keep:
        say("課題シートの「残すもの」を見る")
    for f in keep:
        path = sheet.dir / f
        ok = path.exists() and path.stat().st_size > 0
        print(f"  {S.green('[済]') if ok else S.yellow('[未]')} {f}")
    done, total = work_counts(sheet)
    print(f"\n  課題 {bar(done, total)} {done}/{total}")
    print()
    show_panels(sheet, ("完了条件の確かめ方",))


def cmd_stuck(p: Progress, s: Session, args: list[str]) -> None:
    text = " ".join(args) if args else ask("  何が起きた？: ")
    if not text:
        return
    append_stuck(s.log, text)
    print(S.green(f"  {rel(s.log)} の「詰まったこと」に書きました"))
    say(S.dim("15分たったら手順に切り替え、45分で打ち切る"))


def cmd_timer(p: Progress, args: list[str]) -> None:
    minutes = int(args[0]) if args and args[0].isdigit() else 15
    end = datetime.now() + timedelta(minutes=minutes)
    print(f"{minutes}分を計ります（Ctrl+C で止める）。終わり: {end:%H:%M}")
    try:
        while datetime.now() < end:
            mins, secs = divmod(int((end - datetime.now()).total_seconds()) + 1, 60)
            print(f"\r  残り {mins:02d}:{secs:02d}  ", end="", flush=True)
            time.sleep(1)
    except KeyboardInterrupt:
        print("\n  止めました")
        return
    print("\a")
    print(S.yellow("  時間です。"), end="")
    say("詰まっているなら、エラー文を全文読む→man→最小の再現→検索、の順に切り替える", indent="")


def cmd_retro(p: Progress, args: list[str], session: Session | None = None) -> None:
    s = session or load_session()
    log = (ROOT / args[0]) if args else s.log
    if not log.exists():
        die(f"{rel(log)} がありません")
    rule(f"振り返り（{rel(log)}）")
    if not retro_fields(log):
        print(S.green("  全部埋まっています"))
        return
    say(S.dim("1つずつ聞きます。Enterだけで飛ばせます。q でやめます"))
    print()
    seen: set[int] = set()
    while True:
        fields = [f for f in retro_fields(log) if f[0] not in seen]
        if not fields:
            break
        index, label = fields[0]
        seen.add(index)
        got = ask(f"  {label}\n  > ")
        if got == "q":
            break
        if got:
            retro_write(log, index, got)
    left = len(retro_fields(log))
    print()
    print(S.green("  全部埋まりました") if not left else S.yellow(f"  まだ{left}個 空いています（『retro』でいつでも続けられます）"))


def cmd_done(p: Progress, args: list[str]) -> None:
    unit = (args[0] if args else p.unit).upper()
    if p.is_done(unit):
        print(f"{unit} は、すでに完了になっています")
        return
    sheet = load_sheet(unit)
    if sheet:
        show_panels(sheet, ("完了条件の確かめ方",))
        done, total = work_counts(sheet)
        if total and done < total:
            print(S.yellow(f"  課題が {done}/{total} です"))
        miss = sheet.missing_files()
        if miss:
            print(S.yellow(f"  残すものが、まだ無い（または空）: {'、'.join(miss)}"))
    if not confirm("\n  上を満たしましたか？ 記録する場合は y [y/N]: "):
        print("  記録しませんでした")
        return
    if not p.mark_done(unit):
        die(f"PROGRESS.md に「- [ ] {unit} ...」の行がありません")
    print(S.green(f"  PROGRESS.md に記録しました（{date.today():%Y-%m-%d}）"))
    nxt = ask("  次のユニットのID（Enterで変えない）: ")
    if nxt:
        p.set_next(nxt.upper(), db=nxt.upper().startswith("D"))
        print(S.green(f"  「次のユニット」を {nxt.upper()} にしました"))


def cmd_end(p: Progress, s: Session) -> None:
    rule("今日の振り返り")
    holes = retro_fields(s.log)
    if holes:
        print(S.yellow(f"  書いていない欄が{len(holes)}個あります"))
        for _, label in holes[:8]:
            print(f"    - {label}")
        if confirm("\n  いま埋めますか？ [y/N]: "):
            cmd_retro(p, [], session=s)
    else:
        print(S.green("  全部埋まっています"))

    sheet = load_sheet(p.unit)
    if sheet:
        print()
        rule(f"{p.unit} の状態")
        done, total = work_counts(sheet)
        print(f"  課題 {bar(done, total)} {done}/{total}")
        miss = sheet.missing_files()
        print(S.yellow(f"  残すものが足りない: {'、'.join(miss)}") if miss else S.green("  残すもの: 揃っています"))
        if total and done == total and not miss and not p.is_done(p.unit):
            if confirm(f"\n  {p.unit} を完了として記録しますか？ [y/N]: "):
                cmd_done(p, [p.unit])

    print()
    rule("コミット")
    code, dirty = git("status", "--porcelain")
    if code != 0:
        say(dirty)
        return
    if not dirty:
        print(S.green("  変更はありません（すべてコミット済み）"))
    else:
        for line in dirty.splitlines()[:20]:
            print("  " + line)
        head = f"[no-ai] {p.unit}: "
        extra = ask(f"\n  コミットメッセージ（「{head}」に続ける。Enterで手で打つ）: ").strip()
        if extra and not confirm(f"  「{head}{extra}」でコミットしますか？ [y/N]: "):
            extra = ""
        if extra:
            git("add", "-A")
            code, out = git("commit", "-m", head + extra)
            print(S.green("  コミットしました") if code == 0 else S.red(f"  失敗: {out}"))
            if code == 0 and confirm("  push しますか？ [y/N]: "):
                code, out = git("push", "origin", "HEAD")
                print(S.green("  push しました") if code == 0 else S.red(f"  失敗: {out}"))
        else:
            print(S.dim("  git add -A"))
            print(S.dim(f'  git commit -m "{head}<やったこと>"'))
            print(S.dim("  git push origin main"))
    code, ahead = git("log", "--oneline", "@{u}..")
    if code == 0 and ahead:
        print(S.yellow(f"  push していないコミットが{len(ahead.splitlines())}件あります"))


def cmd_help() -> None:
    print((__doc__ or "").strip())
    print()
    rows = [
        ("（引数なし）", "ダッシュボードとメニュー"),
        ("run", "セッションを順に案内する（課題を1問ずつ）"),
        ("today", "今日やることの一覧"),
        ("next [ID]", "次の課題だけ表示する"),
        ("tick <番号> [ID]", "課題を「できた」にする"),
        ("status", "進捗と、作業漏れの疑い"),
        ("unit [ID]", "課題シートを読む"),
        ("find <語>", "ドキュメント・課題シート・自分のメモを検索する"),
        ("check [ID]", "確認コマンドを実行し、残すものと完了条件を見る"),
        ("stuck [文]", "詰まりメモを、振り返りの「詰まったこと」に書く"),
        ("timer [分]", "残り時間を計る（既定15分）"),
        ("retro [ファイル]", "振り返りの空欄を、1つずつ聞いて埋める"),
        ("done [ID]", "完了条件を確かめて、PROGRESS.md に記録する"),
        ("end", "終わりの手続き（記入漏れ、残すもの、コミット）"),
    ]
    for name, desc in rows:
        print(f"  {name}{' ' * max(1, 26 - width(name))}{desc}")
    print()
    say(S.dim("このコマンドはAIを使わない。答えも出さない。AIに頼むときの文面は prompts/ にある"))


# ---------------------------------------------------------------- 入口


def main(argv: list[str]) -> int:
    if argv and argv[0] in ("-h", "--help", "help"):
        cmd_help()
        return 0
    p = load_progress()
    s = load_session()
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    sub = argv[0] if argv else ("menu" if interactive else "today")
    args = argv[1:]
    table = {
        "menu": lambda: (show_dashboard(p, s), show_menu(p, s)),
        "run": lambda: cmd_run(p, s),
        "today": lambda: cmd_today(p, s),
        "next": lambda: cmd_next(p, args),
        "tick": lambda: cmd_tick(p, args),
        "status": lambda: cmd_status(p, s),
        "unit": lambda: cmd_unit(p, args),
        "find": lambda: cmd_find(p, args),
        "check": lambda: cmd_check(p, args),
        "stuck": lambda: cmd_stuck(p, s, args),
        "timer": lambda: cmd_timer(p, args),
        "retro": lambda: cmd_retro(p, args, session=s),
        "done": lambda: cmd_done(p, args),
        "end": lambda: cmd_end(p, s),
    }
    if sub not in table:
        print(S.red(f"error: 知らないサブコマンド: {sub}"), file=sys.stderr)
        print(file=sys.stderr)
        cmd_help()
        return 1
    try:
        table[sub]()
    except Abort:
        print(S.dim("中断しました。続きは ./scripts/offgrid run"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
