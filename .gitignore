# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Go
*.exe
*.test
*.out
coverage.*
/bin/
dist/

# Node
node_modules/
.vite/

# env / secrets
.env
.env.*
!.env.example

# data
*.dump
*.sqlite
pgdata/

# Claude Code session permissions (personal, not part of the template)
.claude/settings.json
.claude/settings.local.json

# Python
__pycache__/
*.pyc

# offgrid が作る、その日の進行の記録（コミットしなくてよい）
logs/**/.*.state.json

# go build でできる実行ファイル（配布はリリースの資産で行う）
/tools/offgrid/offgrid

# 課題のログや出力（課題シートが「コミットしない」と書くもの）
*.log

# offgrid が書き込みの排他に使うロック（コミットしない）
.offgrid.lock
