---
// Overrides Starlight's ThemeProvider so that light is the default when the visitor
// has not chosen a theme yet (Starlight's own default follows the OS setting).
// The theme selector in the header still works, including its "システム" option.
import { Icon } from '@astrojs/starlight/components';
---

{/* This is intentionally inlined to avoid FOUC. */}
<script is:inline>
	window.StarlightThemeProvider = (() => {
		const key = 'starlight-theme';
		let stored = null;
		try {
			stored = localStorage.getItem(key);
		} catch {
			stored = null;
		}
		// 一度も選んでいない人には、ライトを既定にする（Starlight と Rapide の既定は OS 設定）。
		// 「システム」を選んだ人は空文字が入るので、その選択は尊重する。
		if (stored === null) {
			try {
				localStorage.setItem(key, 'light');
			} catch {
				/* localStorage が使えない環境でも、下でライトにする */
			}
			stored = 'light';
		}
		const theme =
			stored === 'dark' || stored === 'light'
				? stored
				: window.matchMedia('(prefers-color-scheme: dark)').matches
					? 'dark'
					: 'light';
		document.documentElement.dataset.theme = theme;
		return {
			updatePickers(theme = stored || 'auto') {
				document.querySelectorAll('starlight-theme-select').forEach((picker) => {
					const select = picker.querySelector('select');
					if (select) select.value = theme;
					/** @type {HTMLTemplateElement | null} */
					const tmpl = document.querySelector(`#theme-icons`);
					const newIcon = tmpl && tmpl.content.querySelector('.' + theme);
					if (newIcon) {
						const oldIcon = picker.querySelector('svg.label-icon');
						if (oldIcon) {
							oldIcon.replaceChildren(...newIcon.cloneNode(true).childNodes);
						}
					}
				});
			},
		};
	})();
</script>

<template id="theme-icons">
	<Icon name="sun" class="light" />
	<Icon name="moon" class="dark" />
	<Icon name="laptop" class="auto" />
</template>
